# Copy this file to `.env` and fill in real values.
# `.env` is gitignored — never commit real secrets.

# --- Database ---
# Local dev (SQL Server LocalDB):
#   ConnectionStrings__DefaultConnection=Server=(localdb)\MSSQLLocalDB;Database=AgroAdvisor;Trusted_Connection=True;TrustServerCertificate=True
# Local dev (Docker SQL Server):
#   ConnectionStrings__DefaultConnection=Server=localhost,1433;Database=AgroAdvisor;User Id=sa;Password=Your_strong_password1;TrustServerCertificate=True
# Azure SQL:
#   ConnectionStrings__DefaultConnection=Server=tcp:<name>.database.windows.net,1433;Database=AgroAdvisor;User Id=<user>;Password=<pwd>;Encrypt=True;
ConnectionStrings__DefaultConnection=

# --- JWT ---
# Must be at least 32 characters.
Jwt__Key=

# --- Gemini (image analysis) ---
GeminiSettings__ApiKey=

# --- Pexels (image search) ---
Pexels__ApiKey=

# --- Fertilizer AI insight (Gemini or OpenAI-compatible) ---
# Leave blank to use the deterministic fallback summary.
AiOptions__ApiKey=
AiOptions__Model=gemini-1.5-flash
AiOptions__Endpoint=https://generativelanguage.googleapis.com/v1beta/models/{model}:generateContent

# --- Chatbot AI (can override the shared AI provider settings) ---
ChatAiOptions__ApiKey=
ChatAiOptions__Model=gemini-1.5-flash
ChatAiOptions__Endpoint=https://generativelanguage.googleapis.com/v1beta/models/{model}:generateContent
ChatAiOptions__SystemPrompt=You are AgroAdvisor's agronomy assistant. Give concise, practical guidance for farming questions. Mention uncertainty when appropriate and end with: This is general guidance.
